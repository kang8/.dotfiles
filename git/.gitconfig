[user]
    name = kang
    email = yi1115610574@gmail.com
    signingkey = 716B162E703DA80C
[color]
    ui = auto
[core]
    untrackedCache = true
    editor = nvim
    pager = "{                                                    \
        COLUMNS=$(tput cols);                                     \
        if [ $COLUMNS -ge 160 ]; then                             \
            sed 's/\t/├──┤/g' | delta --side-by-side -w $COLUMNS; \
        else                                                      \
            sed 's/\t/├──┤/g' | delta;                            \
        fi                                                        \
    }"
    quotepath = false
    excludesfile = ~/.gitignore-global
    attributesfile = ~/.gitattributes-global
[help]
    autocorrect = immediate
[interactive]
    diffFilter = delta --color-only
    singlekey = true
[delta]
    true-color = always
    line-numbers = true
    light = true
    navigate = true
    # unset hunk-label, let navigate skip hunk
    hunk-label
    hyperlinks = true
    # unset hyperlinks-file-link-format, I do not like this feature
    hyperlinks-file-link-format
    ; wrap-max-lines = 10
[commit]
    gpgsign = true
    verbose = true
[gpg]
    program = gpg
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
[protocol]
    version = 2
[includeIf "gitdir:~/Projects/"]
    path = ~/.gitconfig-work
[diff]
    renames = true
    colorMoved = default
    algorithm = histogram
    submodule = log
[merge]
    conflictstyle = zdiff3
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P
[push]
    autoSetupRemote = true
    default = current
[alias]
    cleanup = !zsh -c --interactive 'gbda' # use onmyzsh function
    fixup = "!git log -n 15 --pretty=format:'%h %cs |%aL| %s' --no-merges | fzf | cut -c -7 | xargs -o git history fixup"
    # record the stack parent read by starship: `git stack-parent [<branch>]`, no arg = the MR's target via glab
    stack-parent = "!f() { b=$(git symbolic-ref --short HEAD) || return; d=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); d=${d#origin/}; p=${1:-$(glab mr list --source-branch \"$b\" -F json | jq -r '.[0].target_branch // empty')}; if [ -n \"$p\" ] && [ \"$p\" != \"${d:-master}\" ]; then git config \"branch.$b.stackParent\" \"$p\" && echo \"$b -> $p\"; else git config --unset \"branch.$b.stackParent\"; echo \"$b: no stack parent\"; fi; }; f"
[hook "commit-confetti"]
    event = post-commit
    command = ~/.config/git/hooks/post-commit
[http]
    maxRetries = 3
    maxRetryTime = 60
[gc]
    auto = 0
[rebase]
    autoSquash = true
    autoStash = true
[sendemail]
    smtpserver = smtp.gmail.com
    smtpuser = yi1115610574@gmail.com
    smtpencryption = tls
    smtpserverport = 587
[format]
    pretty = fuller
[log]
    date = iso
[blame]
    date = format:%Y-%m-%d
[rerere]
    enabled = true
[url "git@github.com:"]
    pushInsteadOf = https://github.com/
[transfer]
    fsckObjects = true
[fetch]
    fsckObjects = true
    prune = true
    pruneTags = true
    all = true
[receive]
    fsckObjects = true
[status]
    submoduleSummary = true
    compareBranches = @{upstream} @{push}
[advice]
    detachedHead = false
[diff "pandoc"]
    textconv = pandoc --sandbox --to=markdown
[merge "lockfile"]
	name = keep ours, regenerate from the manifest
	driver = sh -c 'echo \"merge: kept OUR $1 — regenerate it from the manifest before committing\" >&2' -- %P
