# cron hands these a bare PATH with no Homebrew on it, so every line that needs
# brew (or anything brew installed) sources the prefix itself. The prefix
# differs per machine, hence the helper rather than a literal path.

# Run at 10:00 every day
# Homebrew knobs repeated from env.zsh, which cron does not read.
0 10 * * * /bin/zsh -c 'eval "$($HOME/.local/bin/brew-shellenv)" && brew update && HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 brew upgrade --no-quit'

# Run at 10:05 every day
5 10 * * * ~/.local/bin/cleanup-merged-branches.sh

# Run at 11:00 every day
0 11 * * * /bin/zsh -c 'eval "$($HOME/.local/bin/brew-shellenv)" && cd ~/.dotfiles && brew bundle dump --no-restart --no-vscode --no-go --no-npm --no-describe --force && make format'

# Run at 11:05 every day
5 11 * * * cd ~/Library/Rime && git pull

# Run at 15:00 every day
0 15 * * * ~/.local/bin/screenshot_all_displays.sh && open ~/Applications/ScreenshotAllDisplays.app

# Run at 11:10 every day
10 11 * * * cd ~/.dotfiles && git submodule update --remote

# Run at 11:31 every Tuesday
31 11 * * 2 cd ~/.config/nvim && git fetch && git rebase origin/master && ~/.local/share/bob/nvim-bin/nvim --headless "+Lazy! restore" +qa

# Run at 10:30 every day
30 10 * * * /bin/zsh -c 'eval "$($HOME/.local/bin/brew-shellenv)" && npx -y skills@latest update -g -y'
