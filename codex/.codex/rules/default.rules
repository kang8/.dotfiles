prefix_rule(
    pattern = ["gh", "auth", "status"],
    decision = "allow",
    justification = "Read-only inspection of GitHub authentication status",
    match = [
        "gh auth status",
        "gh auth status --hostname github.com",
    ],
    not_match = [
        "gh auth login",
        "gh auth logout",
    ],
)

prefix_rule(
    pattern = ["gh", "repo", "view"],
    decision = "allow",
    justification = "Read-only inspection of GitHub repository metadata",
    match = [
        "gh repo view",
        "gh repo view openai/codex --json name,visibility",
    ],
    not_match = [
        "gh repo clone openai/codex",
        "gh repo delete openai/codex",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "scripts/fetch_mail.py"],
    decision = "allow",
    justification = "Reading Apple Mail requires execution outside the sandbox",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Git commits require access to the host SSH signing agent",
    match = [
        "git commit",
        "git commit -m example",
    ],
    not_match = [
        "git status",
        "git push",
    ],
)
