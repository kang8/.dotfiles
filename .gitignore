__pycache__/
.zcompdump*
.DS_Store
.oh-my-zsh
.env
Brewfile.lock.json

kitty/.config/kitty/kitty.conf.bak

# Emacs packages
emacs/.emacs.d/elpa/
emacs/.emacs.d/auto-save-list/

navi/.config/navi/navi.log
git/.config/glab-cli/config.yml

# k9s
k9s/.config/k9s/clusters/
k9s/.config/k9s/screen-dumps/
hammerspoon/.hammerspoon/Spoons/
claude/.claude/debug.log

# codex runtime data (never version — credentials, history, DBs, sessions)
codex/.codex/auth.json
codex/.codex/history.jsonl
codex/.codex/*.sqlite*
codex/.codex/session_index.jsonl
codex/.codex/.codex-global-state.json*
codex/.codex/sessions/
codex/.codex/log/
codex/.codex/logs_*
codex/.codex/plugins/

# Agent skills: only the ones written here are versioned. Third-party skills are
# a cache rebuilt by agents/.agents/restore-skills.sh from .skill-lock.json, so
# adding one of your own means adding it below too - restore-skills.sh warns
# about any skill that is neither locked nor committed.
agents/.agents/skills/*
!agents/.agents/skills/commit/
!agents/.agents/skills/condense-comments/
!agents/.agents/skills/gitlab-mr-review/
!agents/.agents/skills/squash-branch/
!agents/.agents/skills/web-to-epub/
