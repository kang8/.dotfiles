# claude-resume: an fzf picker over `~/.claude/history.jsonl` for resuming Claude
# Code sessions. Derived from junegunn's everything.fzf/claude.fzf, but without
# the tmux integration and with project-scoped browsing:
#
#   * defaults to sessions of the current directory (like `claude --resume`),
#   * Ctrl-A shows every project,
#   * Alt-P (Option-P on macOS) pops up a picker to scope to any single project.

require 'json'
require 'time'
require 'shellwords'
require 'tmpdir'

begin
  require 'ansi256'
rescue LoadError
  require 'bundler/inline'
  gemfile(true) do
    source 'https://rubygems.org'
    gem 'ansi256'
  end
end

HISTORY = File.expand_path('~/.claude/history.jsonl')
abort "History file not found: #{HISTORY}" unless File.exist?(HISTORY)

HOME = Dir.home
RS = "\x0"
ZWSP = "​"

entries = File.foreach(HISTORY).filter_map do |line|
  JSON.parse(line, symbolize_names: true)
      .tap { it => { sessionId:, timestamp:, display:, project: } }
rescue JSON::ParserError, NoMatchingPatternKeyError
  nil
end

def format_time(timestamp)
  Time.at(timestamp / 1000).localtime.strftime('%F %a %T')
end

# --preview SESSION: render every history entry of a single session.
if ARGV.delete('--preview')
  session = ARGV.first
  abort 'usage: claude-resume --preview SESSION' unless session

  entries = entries.select { it[:sessionId] == session }

  entries.sort_by { -it[:timestamp].to_i }.each_with_index do |entry, idx|
    idx = "##{entries.length - idx}/#{entries.length}"
    entry => { timestamp:, display: }

    header = "#{idx.green} #{format_time(timestamp).cyan}"
    puts header
    puts ('▔' * header.plain.length).dim
    puts display.italic
    puts
  end
  exit
end

# --projects: list distinct project directories, most-recently-active first.
# Feeds the Alt-P picker.
if ARGV.delete('--projects')
  entries.group_by { it[:project] }
         .map { |proj, items| [proj, items.map { it[:timestamp].to_i }.max] }
         .sort_by { -it[1] }
         .each { puts it.first }
  exit
end

# SESSION: given a bare session id (UUID), resume it directly instead of opening
# the picker — mirrors the old `resume = claude --resume` alias. If the session
# is known to history, cd into its project first so it resumes from anywhere;
# otherwise fall back to resuming in the current directory.
UUID = /\A\h{8}-\h{4}-\h{4}-\h{4}-\h{12}\z/
if (session = ARGV.find { it =~ UUID })
  if (entry = entries.find { it[:sessionId] == session }) &&
     File.directory?(entry[:project])
    Dir.chdir(entry[:project])
  end
  exec 'claude', '--resume', session
end

# ANSI 256 color palette, skipping the darkest cube colors for legibility.
COLORS = (17..230).select do |c|
  idx = c - 16
  rgb = [idx / 36, (idx / 6) % 6, idx % 6]
  r, g, b = rgb
  rgb.sum >= 7 && r > g && g > b
end.freeze

# Deterministic per-session color, stable across reload subprocesses (unlike
# String#hash, which is seeded per process).
def color_for(session)
  COLORS[session.bytes.sum % COLORS.size]
end

# Assign each entry a line offset into its session's preview, so selecting a
# specific entry can scroll the preview to it (`--preview-window +{4}`).
def with_offsets(entries)
  entries.group_by { it[:sessionId] }.transform_values do |items|
    items = items.sort_by { -it[:timestamp].to_i }
    offset = 1
    items.map do |item|
      item.merge(offset: offset).tap do
        offset += item[:display].to_s.each_line.count + 3
      end
    end
  end.values.flatten
end

# Eight hex digits is enough to tell sessions apart by eye — no prefix collides
# across a 2700-session history — and it spends 28 fewer columns than the UUID.
# The full id still rides along in field 2 for the resume command.
SESSION_ID_WIDTH = 8

# Scoped to one project, every row repeats the same path, so the column is
# 20-30 wasted columns saying nothing. The border label already names the scope.
def column_header(scoped)
  cols = ['TIMESTAMP'.ljust(23), 'SESSION'.ljust(SESSION_ID_WIDTH)]
  cols << 'PROJECT' unless scoped
  cols.map(&:bold).join('  ')
end

# --list [--all | --scope-file FILE]: emit the NUL-delimited fzf input.
#
# Scope is resolved as: --all -> every project; --scope-file -> the project path
# in FILE (empty file means every project); otherwise $CLAUDE_FZF_PROJECT if set.
if ARGV.delete('--list')
  scope =
    if ARGV.delete('--all')
      nil
    elsif (i = ARGV.index('--scope-file'))
      f = ARGV[i + 1]
      val = (File.read(f).lines.first&.strip if f && File.exist?(f))
      val unless val.to_s.empty?
    elsif !(env = ENV['CLAUDE_FZF_PROJECT'].to_s).empty?
      env
    end

  entries = with_offsets(entries)
  entries = entries.select { it[:project] == scope } if scope

  $stdout.print((ZWSP * 4) + column_header(scope) + RS)
  entries.sort_by { -it[:timestamp].to_i }.each do |entry|
    entry => { sessionId: session, project:, timestamp:, display:, offset: }

    command = "cd #{project.shellescape} && exec claude -r #{session}"

    cells = [format_time(timestamp).cyan,
             session[0, SESSION_ID_WIDTH].fg(color_for(session))]
    unless scope
      cells << (project.start_with?(HOME) ? project.sub(HOME, '~') : project).blue
    end

    $stdout.print [command, session, project, offset].map { it.to_s + ZWSP }.join
    $stdout.print cells.map { it + ZWSP }.join('  ')
    $stdout.print "\n"
    display.each_line { $stdout.print "  #{it.italic}" }
    $stdout.print RS
  rescue Errno::EPIPE
    break
  end
  exit
end

# Main mode: launch fzf. It pulls its list via `start:reload` (and Ctrl-A/Alt-P
# re-scope via further reloads), so the current environment carries the initial
# scope down to the first `--list` subprocess.
self_esc = __FILE__.shellescape
ruby = "ruby #{self_esc}"
tmp = File.join(Dir.tmpdir, "claude-resume-#{Process.pid}.scope")
at_exit { File.delete(tmp) if File.exist?(tmp) }

pwd = Dir.pwd
if entries.any? { it[:project] == pwd }
  ENV['CLAUDE_FZF_PROJECT'] = pwd
  label = " Claude sessions · #{pwd.start_with?(HOME) ? pwd.sub(HOME, '~') : pwd} "
else
  ENV['CLAUDE_FZF_PROJECT'] = ''
  label = ' Claude sessions · all projects '
end

all_label = ' Claude sessions · all projects '

# Ctrl-A toggles between all projects and the current directory's scope, reading
# the live border label (exported as $FZF_BORDER_LABEL) to know which way to flip.
ctrl_a =
  'ctrl-a:transform:case "$FZF_BORDER_LABEL" in ' \
  "*'all projects'*) " \
  "printf 'change-border-label(%s)+reload(%s --list)' '#{label}' '#{ruby}';; " \
  '*) ' \
  "printf 'change-border-label(%s)+reload(%s --list --all)' '#{all_label}' '#{ruby}';; " \
  'esac'

alt_p =
  "alt-p:execute(#{ruby} --projects | fzf --no-multi --reverse --prompt 'project> ' > #{tmp})" +
  "+transform:[ -s #{tmp} ] && " \
  "printf 'change-border-label( Claude sessions · %s )+reload(#{ruby} --list --scope-file #{tmp})' " \
  "\"$(basename \"$(cat #{tmp})\")\""

fzf_args = [
  'fzf', '--read0', '--ansi', '--reverse', '--style', 'full', '--gap',
  '--wrap', 'word',
  '--delimiter', ZWSP, '--with-nth', '5..', '--accept-nth', '{1}',
  '--highlight-line', '--scheme', 'history',
  '--border-label', label,
  '--header', 'Ctrl-A: toggle all/current / Alt-P: filter project / Ctrl-/: preview',
  '--header-lines', '1',
  '--header-border', 'dashed', '--header-lines-border', 'inline',
  '--preview', "#{ruby} --preview {2}",
  '--preview-window', 'hidden:wrap-word:+{4}',
  '--bind', 'ctrl-/:toggle-preview',
  '--bind', "start:reload(#{ruby} --list)",
  '--bind', ctrl_a,
  '--bind', alt_p,
  *ARGV
]

selected = IO.popen(fzf_args, 'r', in: File::NULL, &:read).to_s.strip
exec "eval #{selected.shellescape}" unless selected.empty?
